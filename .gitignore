# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.venv/
.eggs/

# pytest
.pytest_cache/

# Examples: only sources and data assets are tracked. Everything else —
# generated .c/.h/CMakeLists, compiled Amiga binaries (extensionless),
# converted .bm bitmaps, Docker/CMake build dirs — is a build artifact.
examples/**
!examples/**/
!examples/**/*.py
!examples/**/*.png
!examples/**/*.mod
!examples/**/*.wav
!examples/**/*.json

# ADF floppy images
*.adf

# Amiberry boot dir — only S/Startup-Sequence is source
amiberry_boot/*
!amiberry_boot/S/

# IDE
.vscode/
.idea/

# Temporary/debug
session
*.log

# OS
.DS_Store
